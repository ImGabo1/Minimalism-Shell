*{
    /* Paleta en escala de grises (colores Mocha eliminados, no se usaban) */
    text: #ffffff;
    subtext1: #cacfdf;
    subtext0: #b5b9c9;
    overlay2: #a5a8b3;
    overlay1: #8f919e;
    overlay0: #737585;
    surface2: #75757a;
    surface1: #4d4f5c33;
    surface0: #3b3c41;
    base: #27272e33;
    mantle: #181825;
    crust: #17171a;

    background:            @text;
    foreground:            @text;
    border-color:          @surface1;
    separatorcolor:        transparent;
    selected-background:   @crust;
    selected-foreground:   @crust;

    font: "JetBrainsMono Nerd Font Propo 13";
}

window {
    background-color: @base;
    border: 2px;
    border-color: @overlay0;
    border-radius: 12.6px;
    padding: 10px;
    width: 360px;
}

mainbox {
    spacing: 20px;
    padding: 0px;
    children: [ inputbar, message, listview ];
}

message {
    color: @text;
    padding: 5;
    border: 0px 2px 2px 2px;
    border-color: @text;
    background-color: @base;
}

inputbar {
    background-color: @base;
    border-radius: 100px;
    padding: 8px;
    spacing: 8px;
}

entry {
    background-color: transparent;
    text-color: @text;
    cursor: text;
    placeholder: "";
}

listview {
    background-color: transparent;
    spacing: 0px;
    scrollbar: false;
    columns: 1;
    lines: 8;
}

element {
    background-color: transparent;
    padding: 8px 10px;
    border-radius: 100px;
}


element-text {
    vertical-align: 0.5;
}


element-icon {
    size: 32px;
    background-color: @surface1;
    border-radius: 100px;
    padding: 10px;
}

element selected.normal {
    background-color: @overlay2;
    text-color: @crust;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
}
